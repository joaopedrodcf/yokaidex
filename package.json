        "@nuxt/ui": "4.10.0",
        "@nuxtjs/seo": "5.3.6",
        "@nuxtjs/sitemap": "8.3.0",
        "@vueuse/core": "14.3.0",
        "nuxt": "4.5.1",
        "tailwindcss": "4.3.3",
        "vue": "3.5.40",
        "vue-router": "5.2.0"
    },
    "devDependencies": {
        "@iconify-json/lucide": "1.2.119",
        "@vite-pwa/nuxt": "1.1.1",
        "oxfmt": "0.60.0",
        "oxlint": "1.75.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "7.0.2",
        "vite": "8.1.5",
